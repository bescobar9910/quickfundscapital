<style>
:root{
  --navy:#071224; --navy2:#0B1E3D; --navy3:#12294F;
  --green:#00D084; --green2:#00B574; --green-dark:#008F5F;
  --gold:#FFC531; --ink:#0F1B2E; --muted:#5B6B84; --line:#E6ECF3;
  --bg:#F7F9FC; --card:#FFFFFF; --radius:20px;
  --shadow:0 20px 50px rgba(7,18,36,.12); --shadow2:0 8px 30px rgba(7,18,36,.08);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Manrope,system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:var(--ink);background:#fff;line-height:1.6;overflow-x:hidden}
h1,h2,h3,h4{font-family:Sora,Manrope,sans-serif;line-height:1.08;letter-spacing:-.02em;margin:0}
a{color:inherit}
img{max-width:100%}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:800;border-radius:999px;padding:16px 28px;text-decoration:none;border:0;cursor:pointer;font-size:16px;transition:.2s;white-space:nowrap}
.btn-green{background:var(--green);color:#04160E;box-shadow:0 10px 25px rgba(0,208,132,.35)}
.btn-green:hover{background:#0be691;transform:translateY(-1px)}
.btn-dark{background:var(--navy);color:#fff}
.btn-white{background:#fff;color:var(--navy)}
.btn-outline{background:transparent;color:#fff;border:1.5px solid rgba(255,255,255,.35)}
.btn-outline-dark{background:#fff;color:var(--navy);border:1.5px solid var(--line)}
.btn-sm{padding:12px 20px;font-size:14px}
.pill{display:inline-flex;align-items:center;gap:8px;background:rgba(0,208,132,.14);color:#7CFFC4;border:1px solid rgba(0,208,132,.25);padding:7px 12px;border-radius:999px;font-weight:800;font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.pill-light{background:#E8FFF4;color:#007A4D;border-color:#C9F5DE;text-transform:none;letter-spacing:0;font-size:13px}
section{padding:88px 0}
.kicker{font-weight:800;letter-spacing:.12em;text-transform:uppercase;font-size:12px;color:var(--green-dark);margin-bottom:12px}
.section-title{font-size:clamp(30px,4vw,46px);max-width:760px}
.section-sub{color:var(--muted);font-size:18px;max-width:700px;margin-top:14px}

/* Topbar + Nav */
.topbar{background:#040B18;color:#CBD6E6;font-size:13px}
.topbar .wrap{display:flex;justify-content:space-between;gap:16px;padding-top:9px;padding-bottom:9px;flex-wrap:wrap}
.topbar a{color:#fff;text-decoration:none;font-weight:700}
.topbar i{color:var(--green);margin-right:6px}
header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-top:14px;padding-bottom:14px}
.cta-short{display:none}
@media(max-width:900px){.cta-full{display:none}.cta-short{display:inline}}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none}
.logo-mark{width:44px;height:44px;border-radius:12px;background:var(--navy);display:grid;place-items:center;color:var(--green);font-family:Sora;font-weight:800;font-size:20px}
.logo-text{line-height:1}
.logo-text b{font-family:Sora;font-size:19px;letter-spacing:-.02em;display:block}
.logo-text span{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:800}
.nav-links{display:flex;gap:28px;align-items:center}
.nav-links a{text-decoration:none;font-weight:700;font-size:15px;color:#263650}
.nav-links a:hover{color:var(--green-dark)}
.mobile-menu-btn{display:none;background:none;border:0;font-size:22px}
@media(max-width:900px){.nav-links{display:none}.nav-links.open{display:flex;position:absolute;top:73px;left:16px;right:16px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px;flex-direction:column;align-items:stretch;box-shadow:var(--shadow)} .mobile-menu-btn{display:block} .nav .btn{padding:10px 14px;font-size:13px}}

/* Hero */
.hero{background:radial-gradient(900px 500px at 85% -10%, rgba(0,208,132,.28), transparent 60%), radial-gradient(700px 400px at 0% 110%, rgba(255,197,49,.16), transparent 60%), linear-gradient(180deg,var(--navy) 0%, var(--navy2) 100%);color:#fff;padding:56px 0 0;position:relative;overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:48px;align-items:center;padding-bottom:56px}
@media(max-width:900px){.hero-grid{grid-template-columns:1fr}}
.hero h1{font-size:clamp(38px,5.6vw,64px);font-weight:800}
.hero h1 em{font-style:normal;color:var(--green)}
.hero h1 .gold{color:var(--gold)}
.hero p.lead{font-size:19px;color:#C9D6EA;max-width:560px;margin:18px 0 22px}
.checks{list-style:none;padding:0;margin:0 0 26px;display:grid;grid-template-columns:1fr 1fr;gap:10px 18px}
@media(max-width:520px){.checks{grid-template-columns:1fr}}
.checks li{font-weight:700;font-size:15px;display:flex;gap:10px;align-items:flex-start}
.checks i{color:var(--green);margin-top:4px}
.hero-ctas{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.hero-note{font-size:13px;color:#8FA3BF;margin-top:14px}
.hero-note i{color:var(--green)}
.stars{color:var(--gold);letter-spacing:2px}
.hero-card{background:#fff;color:var(--ink);border-radius:24px;padding:26px;box-shadow:0 30px 80px rgba(0,0,0,.35)}
.hero-card h3{font-size:22px;margin-bottom:4px}
.hero-card p{color:var(--muted);font-size:14px;margin:0 0 18px}
.mini-stats{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin:18px 0}
.mini-stats div{background:var(--bg);border:1px solid var(--line);border-radius:14px;padding:12px;text-align:center}
.mini-stats b{font-family:Sora;font-size:18px;display:block}
.mini-stats span{font-size:11px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.06em}
label{font-weight:800;font-size:13px;display:block;margin-bottom:6px}
input,select,textarea{width:100%;padding:14px 14px;border:1.5px solid var(--line);border-radius:12px;font:inherit;font-size:15px;background:#fff;color:var(--ink)}
input:focus,select:focus,textarea:focus{outline:3px solid rgba(0,208,132,.25);border-color:var(--green2)}
.field{margin-bottom:14px}
.range-val{font-family:Sora;font-weight:800;font-size:28px}
input[type=range]{padding:0;border:0;accent-color:var(--green2);height:28px}
.trustbar{border-top:1px solid rgba(255,255,255,.12);padding:20px 0 26px}
.trustbar .wrap{display:flex;gap:28px;flex-wrap:wrap;justify-content:space-between;align-items:center}
.trust-item{display:flex;gap:10px;align-items:center;font-weight:800;font-size:14px;color:#E6EEF8}
.trust-item i{color:var(--green);font-size:20px}
.trust-item small{display:block;color:#8FA3BF;font-weight:600}

/* Stats */
.stats{background:var(--navy);color:#fff;padding:34px 0}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center}
@media(max-width:800px){.stats-grid{grid-template-columns:1fr 1fr}}
.stats-grid b{font-family:Sora;font-size:clamp(26px,3vw,38px);display:block;color:#fff}
.stats-grid b span{color:var(--green)}
.stats-grid p{margin:4px 0 0;color:#9FB0C9;font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.08em}

/* Cards */
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media(max-width:900px){.grid3,.grid2{grid-template-columns:1fr}}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:28px;box-shadow:var(--shadow2)}
.icon-box{width:52px;height:52px;border-radius:14px;background:#E8FFF4;color:#007A4D;display:grid;place-items:center;font-size:22px;margin-bottom:16px}
.icon-box.navy{background:var(--navy);color:var(--green)}
.icon-box.gold{background:#FFF6D6;color:#8A6500}
.card h3{font-size:20px;margin-bottom:8px}
.card p{color:var(--muted);margin:0}
.bg-soft{background:var(--bg)}
.bg-navy{background:var(--navy);color:#fff}
.bg-navy .section-sub{color:#A9BCD8}
.bg-navy .card{background:var(--navy2);border-color:rgba(255,255,255,.1);color:#fff}
.bg-navy .card p{color:#A9BCD8}

/* How it works */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;counter-reset:step}
@media(max-width:900px){.steps{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.steps{grid-template-columns:1fr}}
.step{background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px;position:relative}
.step-num{width:38px;height:38px;border-radius:50%;background:var(--green);color:#04160E;font-family:Sora;font-weight:800;display:grid;place-items:center;margin-bottom:14px}
.step h3{font-size:18px;margin-bottom:6px}.step p{color:var(--muted);font-size:15px;margin:0}

/* Products */
.price{font-family:Sora;font-size:15px;font-weight:800;color:var(--green-dark);text-transform:uppercase;letter-spacing:.06em}
.product ul{list-style:none;padding:0;margin:16px 0 20px}
.product li{padding:7px 0;border-bottom:1px dashed var(--line);font-size:15px;display:flex;gap:10px}
.product li i{color:var(--green2);margin-top:4px}
.badge-pop{position:absolute;top:-12px;right:18px;background:var(--gold);color:#231900;font-weight:800;font-size:12px;padding:6px 10px;border-radius:999px}
.product{position:relative}

/* Industries */
.industries{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:900px){.industries{grid-template-columns:repeat(2,1fr)}}
.ind{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;font-weight:800}
.ind i{width:40px;height:40px;border-radius:10px;background:#EEF4FF;color:var(--navy2);display:grid;place-items:center;flex-shrink:0}

/* Table */
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:18px;background:#fff}
table{width:100%;border-collapse:collapse;min-width:640px}
th,td{padding:16px;text-align:left;border-bottom:1px solid var(--line);font-size:15px;vertical-align:top}
th{background:var(--navy);color:#fff;font-family:Sora}
th.highlight{background:var(--green2);color:#04160E}
td.highlight{background:#EFFFF7;font-weight:700}
tr:last-child td{border-bottom:0}

/* Testimonials */
.testi{background:#fff;border:1px solid var(--line);border-radius:20px;padding:26px}
.testi p{font-size:16px}
.testi-person{display:flex;gap:12px;align-items:center;margin-top:18px}
.avatar{width:46px;height:46px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font-weight:800;font-family:Sora}
