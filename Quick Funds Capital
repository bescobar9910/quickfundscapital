<script>
function fmt(n){return '$'+Math.round(n).toLocaleString('en-US')}
function fmtK(n){return n>=1000?'$'+Math.round(n/1000)+'K':fmt(n)}
// Hero estimator: 1.0x - 1.5x monthly revenue
var heroRev=document.getElementById('heroRevenue');
function updHero(){var v=+heroRev.value;document.getElementById('heroRevenueVal').innerHTML=fmt(v)+'<span style="font-size:14px;color:#5B6B84;font-weight:600"> / month</span>';document.getElementById('heroEstLow').textContent=fmtK(v*1.0);document.getElementById('heroEstHigh').textContent=fmtK(v*1.5);}
heroRev.addEventListener('input',updHero);updHero();
// Calculator
var cRev=document.getElementById('calcRev'),cTime=document.getElementById('calcTime'),cCred=document.getElementById('calcCredit');
function updCalc(){var v=+cRev.value;document.getElementById('calcRevVal').textContent=fmt(v);var mult=1.2*parseFloat(cTime.value)*parseFloat(cCred.value);var est=Math.min(500000,Math.max(10000,v*mult));document.getElementById('calcResult').textContent=fmt(est);document.getElementById('calcRange').textContent=fmt(est*0.85)+' – '+fmt(est);}
[cRev,cTime,cCred].forEach(function(el){el.addEventListener('input',updCalc);el.addEventListener('change',updCalc)});updCalc();
// Need slider
var need=document.getElementById('needRange');
need.addEventListener('input',function(){document.getElementById('needVal').textContent=fmt(+need.value)});
// FAQ
document.querySelectorAll('.faq button').forEach(function(b){b.addEventListener('click',function(){var f=b.parentElement;var was=f.classList.contains('open');document.querySelectorAll('.faq').forEach(function(x){x.classList.remove('open')});if(!was)f.classList.add('open');})});
// Funnel — applications are delivered by FormSubmit to this inbox.
// One-time activation: the first live submission triggers a confirmation
// email to this address; the owner must click "Activate Form" in it once.
var QFC_RECIPIENT='customerservice@quickfundscapital.com';
var QFC_ENDPOINT='https://formsubmit.co/ajax/customerservice@quickfundscapital.com';
var labels={1:'Step 1 of 3 — Your Business',2:'Step 2 of 3 — Funding Needs',3:'Step 3 of 3 — Contact Info',4:'Application Sent ✓'};
function goStep(n){document.querySelectorAll('.fstep').forEach(function(s){s.classList.toggle('active',+s.dataset.step===n)});document.querySelectorAll('.step-alert').forEach(function(a){a.classList.remove('show')});document.getElementById('progressBar').style.width=(n===4?100:(n/3*100))+'%';document.getElementById('stepLabel').textContent=labels[n];document.getElementById('apply').scrollIntoView({behavior:'smooth',block:'start'});}
function fieldValid(el){
  var valid=!!(el.value&&el.value.trim()!=='');
  if(el.type==='email')valid=/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim());
  if(el.id==='phone')valid=el.value.replace(/\D/g,'').length>=10;
  return valid;
}
function fieldLabel(el){
  var wrap=el.closest?el.closest('.field'):el.parentElement;
  var lab=wrap?wrap.querySelector('label'):null;
  return lab?lab.textContent.replace(/\s*\*+\s*$/,'').trim():'';
}
function validateStep(n,move){
  var ok=true;
  var firstBad=null;
  var missing=[];
  var scope=document.querySelector('.fstep[data-step="'+n+'"]');
  if(!scope)return true;
  scope.querySelectorAll('[required]').forEach(function(el){
    var valid=fieldValid(el);
    el.classList.toggle('invalid',!valid);
    if(valid){el.removeAttribute('aria-invalid');}else{el.setAttribute('aria-invalid','true');}
    var err=el.parentElement.querySelector('.error');if(err)err.style.display=valid?'none':'block';
    if(!valid){ok=false;if(!firstBad)firstBad=el;var lb=fieldLabel(el);if(lb)missing.push(lb);}
  });
  var alertBox=scope.querySelector('.step-alert');
  if(alertBox){
    if(ok){alertBox.classList.remove('show');}
    else{
      var msg=alertBox.querySelector('[data-msg]');
      if(msg)msg.textContent=missing.length?('Please complete the highlighted field'+(missing.length>1?'s':'')+' to continue: '+missing.join(', ')+'.'):'Please complete the highlighted fields above to continue.';
      alertBox.classList.add('show');
    }
  }
  if(!ok&&firstBad&&move!==false){
    // Bring the first missing field to the user instead of leaving the
    // Continue button looking dead: scroll it into view and focus it.
    firstBad.scrollIntoView({behavior:'smooth',block:'center'});
    try{firstBad.focus({preventScroll:true});}catch(e){try{firstBad.focus();}catch(e2){}}
  }
  return ok;
}
// Continue ALWAYS advances to the next step — it never sits dead. Any
// fields skipped on the way are only highlighted as a reminder; they are
// enforced at final submit, which jumps back to the earliest step that
// still has missing fields (see the submit handler below).
function nextStep(n){
  var cur=n-1;
  var scope=document.querySelector('.fstep[data-step="'+cur+'"]');
  if(scope)validateStep(cur,false);
  goStep(n);
}
// Bind the Continue / Back buttons with real event listeners, not inline
// onclick attributes, so the step navigation cannot silently fail.
document.querySelectorAll('#appForm [data-next]').forEach(function(b){
  b.addEventListener('click',function(){nextStep(+b.getAttribute('data-next'));});
});
document.querySelectorAll('#appForm [data-back]').forEach(function(b){
  b.addEventListener('click',function(){goStep(+b.getAttribute('data-back'));});
});
// As soon as a highlighted field is fixed, clear its error state (and the
// step alert once nothing on the step is highlighted anymore).
document.querySelectorAll('#appForm [required]').forEach(function(el){
  function clearBad(){
    if(!el.classList.contains('invalid')||!fieldValid(el))return;
    el.classList.remove('invalid');el.removeAttribute('aria-invalid');
    var err=el.parentElement.querySelector('.error');if(err)err.style.display='none';
    var scope=el.closest?el.closest('.fstep'):null;
    if(scope&&!scope.querySelector('.invalid')){
      var ab=scope.querySelector('.step-alert');if(ab)ab.classList.remove('show');
    }
  }
  el.addEventListener('input',clearBad);
  el.addEventListener('change',clearBad);
});
document.getElementById('appForm').addEventListener('submit',function(e){
  e.preventDefault();
  // Enforce completeness across ALL steps at submit: highlight everything
  // missing, then jump to the earliest incomplete step and focus its
  // first missing field so the user lands exactly where the problem is.
  var badStep=0;
  for(var sn=1;sn<=3;sn++){if(!validateStep(sn,false)&&!badStep)badStep=sn;}
  if(badStep){goStep(badStep);validateStep(badStep);return;}
  var g=function(id){var el=document.getElementById(id);return el?el.value.trim():''};
  var lines=[
    'QUICK FUNDS CAPITAL — FUNDING REQUEST','',
    'Business: '+g('bizName'),
    'Industry: '+g('industry'),
    'Time in business: '+g('timeBiz'),
    'Monthly revenue: '+g('monthlyRev'),
    'State: '+g('bizState'),
    'Credit profile: '+g('credit'),'',
    'Funding needed: '+fmt(+need.value),
    'Use of funds: '+g('useFunds'),
    'Timeline: '+g('timeline'),
    'Notes: '+(g('notes')||'—'),'',
    'Contact: '+g('fullName'),
    'Phone: '+g('phone'),
    'Email: '+g('email'),
    'Preferred contact: '+g('contactPref')
  ];
  var text=lines.join('\n');
  document.getElementById('summaryBox').textContent=text;
  var mail=document.getElementById('mailtoBtn');
  mail.href='mailto:'+QFC_RECIPIENT+'?subject='+encodeURIComponent('Funding Request — '+g('bizName'))+'&body='+encodeURIComponent(text+'\n\nI have my last 3 months of bank statements ready to send.');
  window._qfcSummary=text;
  window._qfcMailto=mail.href;

  var btn=document.getElementById('submitBtn');
  var errBox=document.getElementById('sendError');
  var originalBtn=btn.innerHTML;
  errBox.className='send-error';errBox.textContent='';
  btn.disabled=true;
  btn.innerHTML='<span class="spinner" aria-hidden="true"></span> Sending your application…';

  var payload={
    '_subject':'New Funding Request — '+g('bizName')+' ('+fmt(+need.value)+')',
    '_template':'table',
    '_captcha':'false',
    '_replyto':g('email'),
    'Business Legal Name':g('bizName'),
    'Industry':g('industry'),
    'Time in Business':g('timeBiz'),
    'Average Monthly Revenue':g('monthlyRev'),
    'Business State':g('bizState'),
    'Estimated Credit Score':g('credit'),
    'Funding Amount Requested':fmt(+need.value),
    'Use of Funds':g('useFunds'),
    'Timeline':g('timeline'),
    'Notes':g('notes')||'—',
    'Full Name':g('fullName'),
    'Phone':g('phone'),
    'Email':g('email'),
    'Preferred Contact Method':g('contactPref')
  };

  function showSent(){
    var box=document.getElementById('successBox');
    var banner=document.getElementById('sendBanner');
    box.classList.remove('fallback');
    banner.className='send-banner sent';
    document.getElementById('sendBannerIcon').className='fa-solid fa-circle-check';
    document.getElementById('sendBannerText').innerHTML='<b>Application sent.</b> Your request was delivered to our funding team at <b>'+QFC_RECIPIENT+'</b>. Most owners hear back within 2 business hours.';
    document.getElementById('successTitle').textContent='Application received — here’s what happens next';
    document.getElementById('successIntro').textContent='Have your last 3 months of business bank statements ready — your advisor will ask for them to issue a real, underwritten offer. Your summary is below for your records.';
    labels[4]='Application Sent ✓';
    btn.disabled=false;btn.innerHTML=originalBtn;
    goStep(4);
  }
  function showFallback(){
    var box=document.getElementById('successBox');
    var banner=document.getElementById('sendBanner');
    box.classList.add('fallback');
    banner.className='send-banner fallback';
    document.getElementById('sendBannerIcon').className='fa-solid fa-triangle-exclamation';
    document.getElementById('sendBannerText').innerHTML='<b>We couldn’t send this automatically.</b> Your application is ready below — tap <b>“Email a Copy / Send Statements”</b> to send it to <b>'+QFC_RECIPIENT+'</b> from your own email, or call us and we’ll take it over the phone. Don’t close this page until you’ve sent or saved your summary.';
    document.getElementById('successTitle').textContent='Your application is ready — one tap to send it';
    document.getElementById('successIntro').textContent='Use the email button below (it opens with everything pre-filled), copy the summary, or download it. Nothing you entered has been lost.';
    labels[4]='Almost Done — Send Your Application';
    btn.disabled=false;btn.innerHTML=originalBtn;
    errBox.innerHTML='<b>Automatic sending didn’t go through.</b> You’ll see options on the next screen to email it to '+QFC_RECIPIENT+' yourself. <a href="'+window._qfcMailto+'">Email it now →</a>';
    errBox.classList.add('show');
    goStep(4);
  }

  // Deliver via FormSubmit AJAX. Falls back to the manual options above
  // if the service is unreachable, not yet activated, or returns an error.
  if(!window.fetch){showFallback();return;}
  fetch(QFC_ENDPOINT,{
    method:'POST',
    headers:{'Content-Type':'application/json','Accept':'application/json'},
    body:JSON.stringify(payload)
  }).then(function(res){
    if(!res.ok)throw new Error('Send failed: '+res.status);
    return res.json().catch(function(){return {};});
  }).then(function(){showSent();}).catch(function(){showFallback();});
});
function copySummary(){var t=window._qfcSummary||document.getElementById('summaryBox').textContent;if(navigator.clipboard){navigator.clipboard.writeText(t).then(function(){document.getElementById('copyLabel').textContent='Copied ✓';setTimeout(function(){document.getElementById('copyLabel').textContent='Copy Summary'},2000);});}}
function downloadSummary(){var t=window._qfcSummary||'';var blob=new Blob([t],{type:'text/plain'});var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='quick-funds-capital-request.txt';a.click();setTimeout(function(){URL.revokeObjectURL(a.href)},1000);}
</script>
